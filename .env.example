# Application
APP_NAME=Agent-Graph
APP_VERSION=3.0.0
PORT=20050
PUBLIC_API_BASE_URL=http://127.0.0.1:20050
MCP_CLIENT_HOST=127.0.0.1
MCP_CLIENT_PORT=20052
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=20051
BACKEND_PROXY_HOST=127.0.0.1
FRONTEND_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:20051,http://127.0.0.1:20051

# MongoDB client
MONGODB_URL=
MONGODB_DB=agent-graph

# MongoDB containers
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=
MONGO_DATABASE=agent-graph
MONGO_PORT=20040
MONGO_EXPRESS_PORT=20041
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=

# MinIO client
MINIO_ENDPOINT=127.0.0.1:20042
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_BUCKET_NAME=agent-graph

# MinIO container
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=20042
MINIO_CONSOLE_PORT=20043

# Authentication
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
