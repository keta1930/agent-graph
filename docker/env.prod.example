# 生产部署 .env 模板（复制到项目根目录并填入强随机值）
# 与开发用根 .env 的区别：
#   - MongoDB/MinIO 端点由 compose 固定为容器服务名，不需要 *_PORT/ENDPOINT 类变量
#   - MONGO_ROOT_*/MINIO_ROOT_* 同时供容器初始化与应用连接使用
#   - 所有密码必须替换为强随机值（建议 openssl rand -hex 24，字符集 URL 安全）

# 应用
PUBLIC_API_BASE_URL=https://your-domain.example
CORS_ORIGINS=https://your-domain.example
# 应用发布在宿主机 127.0.0.1 的端口（供反向代理回源）
APP_PORT=8080
# 反向代理的地址/网段（uvicorn 只信任它发来的 X-Forwarded-For）；
# 容器化代理填其在共享 Docker 网络上的地址
FORWARDED_ALLOW_IPS=127.0.0.1

# MongoDB（容器 + 应用共用凭据）
MONGO_ROOT_USERNAME=agentgraph
MONGO_ROOT_PASSWORD=
MONGO_DATABASE=agent-graph
MONGO_EXPRESS_PORT=20041
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=

# MinIO（容器 + 应用共用凭据）
MINIO_ROOT_USER=agentgraph
MINIO_ROOT_PASSWORD=
MINIO_CONSOLE_PORT=20043

# 认证
# openssl rand -base64 48
JWT_SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
